{
  "name": "@echovisionlab/youtube-audio",
  "version": "0.1.6",
  "description": "Authenticated server-side YouTube audio resolution and byte-range proxying.",
  "author": "state303 <state303@dsub.io>",
  "keywords": [
    "youtube",
    "audio",
    "streaming",
    "byte-range"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./youtube-js": {
      "types": "./dist/youtube-js.d.ts",
      "import": "./dist/youtube-js.js"
    }
  },
  "files": [
    "dist",
    "DISCLOSURE.md",
    "LICENSE.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echovisionlab/youtube-audio.git"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:clean": "node ./scripts/clean-dist.mjs",
    "package:verify": "node ./scripts/verify-package.mjs",
    "package:pack": "npm pack --dry-run",
    "smoke:youtube-range": "node ./scripts/smoke-youtube-range.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "homepage": "https://github.com/echovisionlab/youtube-audio#readme",
  "bugs": {
    "url": "https://github.com/echovisionlab/youtube-audio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "contentPolicy": {
    "class": "dual-use"
  }
}
